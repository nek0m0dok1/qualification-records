{
  "name": "qualification-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src tests *.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts,vue}\" \"*.ts\" eslint.config.js package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts,vue}\" \"*.ts\" eslint.config.js package.json .prettierrc.json",
    "typecheck": "vite build --mode types && vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-qualification-records --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-qualification-records --only auth,firestore",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "firebase-tools": "^15.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "description": "資格と取得年月、受験履歴を記録するVue 3・TypeScriptアプリです。認証とクラウド保存にFirebaseを使用し、利用者が選択した場合はFirestoreの永続キャッシュで取得済みの記録をオフライン閲覧できます。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nek0m0dok1/qualification-records.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nek0m0dok1/qualification-records/issues"
  },
  "homepage": "https://github.com/nek0m0dok1/qualification-records#readme"
}
